# Copie para /etc/vps-agent.env (chmod 600, dono root) e preencha.

# --- Comum ---
# Pasta onde o agente trabalha. Ele roda como o usuario "agente" e so deve mexer aqui.
AGENT_WORKDIR=/home/agente/work
# Onde ficam log de auditoria, sessoes e jobs.
AGENT_STATE_DIR=/home/agente/.vps-agent
# Modelo do agente autonomo (Claude Agent SDK).
AGENT_MODEL=claude-opus-5-5
# Teto de gasto por tarefa (USD) e de turnos. Protege contra loop caro.
AGENT_MAX_BUDGET_USD=5
AGENT_MAX_TURNS=60

# Credencial do agente: use UMA das duas.
#   Chave da API (cobranca por uso):
ANTHROPIC_API_KEY=
#   Ou token da sua assinatura, gerado com `claude setup-token` na VPS:
CLAUDE_CODE_OAUTH_TOKEN=

# --- Servidor MCP (opcao 1) ---
# Token secreto longo. Gere com:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
MCP_TOKEN=
# Dominio publico que aponta para a VPS (usado na checagem do cabecalho Host).
MCP_PUBLIC_HOST=vps.soswf.com.br
# Endereco da VPS na rede docker do Nginx Proxy Manager (nginx-proxy_default).
# Assim so o NPM alcanca o servidor; ele NAO fica aberto para a internet.
MCP_BIND=172.21.0.1
MCP_PORT=8765
# Timeout padrao e maximo de run_command (segundos).
MCP_CMD_TIMEOUT=120
MCP_CMD_TIMEOUT_MAX=1800

# --- Bot do Telegram (opcao 2) ---
TELEGRAM_BOT_TOKEN=
# IDs de chat autorizados, separados por virgula. Descubra o seu com @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=
