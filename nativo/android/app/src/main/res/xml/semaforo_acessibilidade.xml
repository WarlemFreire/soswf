<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuracao do servico que le a oferta de corrida.

  canRetrieveWindowContent e o que permite ler o texto da tela, e e a razao de
  o recurso existir. O resto e deliberadamente restrito:

  - typeWindowContentChanged e typeWindowStateChanged bastam: sao os eventos em
    que um cartao de oferta aparece. Nao pedimos toque, foco nem digitacao.
  - packageNames limita ao que interessa. Sem isso o servico receberia evento de
    banco, mensagem e tudo mais, e ele nao tem nada que ver isso.
  - notificationTimeout segura a enxurrada: a tela muda muitas vezes por
    segundo, e nenhuma decisao precisa dessa frequencia.

  O usuario habilita isto a mao nas configuracoes do Android e desliga quando
  quiser. O texto lido nao e gravado nem enviado a lugar nenhum.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/semaforo_descricao"
    android:notificationTimeout="500"
    android:packageNames="com.ubercab,com.ubercab.driver,com.taxis99,com.taxis99.driver,sinet.startup.inDriver,sinet.startup.inDriver.driver"
    android:settingsActivity="com.soswf.copiloto.MainActivity" />
